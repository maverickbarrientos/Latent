# Copy to .env and adjust.

# Base URL of the API the browser calls, e.g. https://your-backend.onrender.com
# Leave empty when the backend serves the UI, or when using `npm run dev` (the dev server proxies /api).
# Read at build time: rebuild after changing it.
VITE_API_URL=

# --- Dev server only (`npm run dev`) ---

# Where the dev server proxies /api requests. Must match the backend's HOST and PORT.
API_URL=http://127.0.0.1:8000

# Port for the Vite dev server.
DEV_PORT=5173