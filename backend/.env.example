# Copy to .env and adjust. Read on startup, however the app is launched.

# Address the API listens on. Use 0.0.0.0 to reach it from other devices on your network.
HOST=127.0.0.1

# Port for the API and the built UI. Change it if 8000 is already in use.
PORT=8000

# Browser origins allowed to call the API when the UI is hosted on a different address,
# comma-separated, e.g. https://latent.vercel.app,http://localhost:5173
# Leave empty if the backend serves the UI itself. "*" allows any origin.
CORS_ORIGINS=